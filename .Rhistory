# New dataset containing 1 row per patient
hsb2 = hsb %>% arrange(sch.id, size) %>% group_by(sch.id, size) %>%
summarise( NbStudents = n())
mycontrols  <- arsenal::tableby.control(test=TRUE, total=FALSE,
numeric.stats=c("Nmiss", "median",  "q1q3", "range"),
cat.stats=c("countpct", "Nmiss"),
stats.labels=list(N='Count', Nmiss = "N-Miss", range = 'Range', median='Median', q1q3='Q1,Q3'))
tab <- arsenal::tableby(  ~ NbStudents, data = hsb2, control=mycontrols)
summary(tab, text = TRUE, title = "Number of students evaluated per school", pfootnote=TRUE)
## II.1 Visualisation graphique du niveau de maths par école
hsb3 = hsb %>% arrange(sch.id) %>% filter( sch.id < 1500 )
ggplot(data  = hsb3, aes(x = as.factor(sch.id), y = math))+
geom_boxplot()+
theme_minimal()+
labs(title = "Niveau de maths par école")
## II.3 Modélisation bayésienne simple
fit1_brms <- brm(math ~ 1 + (1|sch.id),
data = hsb,
family = gaussian())
