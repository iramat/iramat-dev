# R packages for data manipulation
library(dplyr); library(tidyverse)
library(kableExtra);
## R package for Calibration of dates
library(rjags)
library(rcarbon) # optionnel
## R packages for Bayesian analyses
library(coda);
library(HDInterval)
library(tidybayes)
library(posterior)
intcal20=read.csv('intcal20.csv',sep=",",dec=".",header=T)
## Import des données
linceul <- matrix(
data = c(
646, 927, 1995, 722, 31, 32, 46, 43,
750, 940, 1980, 755, 30, 30, 35, 30,
676, 941, 1940, 685, 24, 23, 30, 34
),
nrow = 3,
byrow = TRUE
)
colnames(linceul) <- c("age1", "age2", "age3", "age4",
"err1", "err2", "err3", "err4")
rownames(linceul) <- c("Arizona", "Oxford", "Zurich")
dim(linceul) <- c(3, 4, 2)
dimnames(linceul) <- list(
c("Arizona", "Oxford", "Zurich"),
paste("Ech.", 1:4, sep = " "),
c("age", "erreur")
)
linceul = as.data.frame(linceul)
DT::datatable(linceul)
## On fixe les paramètres graphiques
## 'mfrow' permet d'afficher les 4 graphiques sur 2 lignes et 2 colonnes
par(mfrow = c(2, 2), mar = c(3, 4, 0, 0) + 0.1, las = 1)
couleurs <- c("#DDAA33", "#BB5566", "#004488")
## Pour chaque objet daté...
for (j in 1:ncol(linceul)) {
## On définit l'étendue des valeurs en abscisse (années)
k <- range(linceul[, j, 1])
x <- seq(min(k) * 0.8, max(k) * 1.2, by = 1)
## On définit un graphique vide auquel ajouter les distributions
plot(x = NULL, y = NULL, xlim = range(x), ylim = c(0, 0.02),
xlab = "", ylab = "", type = "l")
## On affiche le nom de l'échantillon
text(x = min(k) * 0.9, y = 0.02, labels = colnames(linceul)[j], pos = 1)
## Pour chaque âge obtenu...
for (i in 1:nrow(linceul)) {
## On calcule la fonction de densité de la distribution normale
y <- dnorm(x = x, mean = linceul[i, j, 1], sd = linceul[i, j, 2])
## On trace la courbe
lines(x = x, y = y, type = "l", lty = 1, lwd = 1.5, col = couleurs[[i]])
}
}
## On ajoute une légende au dernier graphique
legend("topright", legend = rownames(linceul), lty = 1, lwd = 1.5, col = couleurs)
