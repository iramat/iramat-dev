## Données archéologiques sur le site de Cuba
dataCuba = read.csv2('AMSdates_Cuba.csv')
M = dataCuba$M
s = dataCuba$s
## Décroissance du radiocarbone # fichier de données
intcal20=read.csv('intcal20.csv',sep=",",dec=".",header=T)
write(file="calibrationCuba.jags",ncolumns=1,x=
"model{
for( i in 1 : 12 ) {
M[i] ~ dnorm(mu[i], tau[i])
tau[i] <- 1/(s[i]*s[i] + sigma[i]*sigma[i])
mu[i] <- interp.lin(t[i], calBP, C14BP)
sigma[i] <- interp.lin(t[i], calBP, sC14BP)
}
for(i in 1:12){
t[i]~ dunif(tmin,tmax)
}
}
")
## Attention, pour l'interpolation linéaire, il faut ordonner les valeurs de façon croissante
courbe <- intcal20 [order(intcal20$CAL.BP), ]
jags <- jags.model("calibrationCuba.jags",
data = list('M' = dataCuba$M,'s'=dataCuba$s,
'calBP'= courbe$CAL.BP,'C14BP'= courbe$X14C.age,'sC14BP'= courbe$Sigma,
'tmin'=0, 'tmax'=5000),
inits = list( t = M ),
n.chains = 2,
n.adapt = 100000)
update(jags,50000)
samp = coda.samples(jags,c('t'),10000,thin =10)
plot(samp)
coda::autocorr.plot(samp)
coda::gelman.diag(samp)
MCMC = as.data.frame( samp[[1]], samp[[2]])
tp <- TempoPlot(MCMC, c(1:12), level = 0.95, count = FALSE)
MinMaXGroup = CreateMinMaxGroup( MCMC, c(1:5), name = "YC", add=NULL, exportFile = NULL)
MinMaXGroup = CreateMinMaxGroup( MCMC, c(6:12), name = "OC", add=MinMaXGroup, exportFile = NULL)
MultiPhasePlot( MinMaXGroup, c(3, 1), level = 0.95)
