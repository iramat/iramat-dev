Ech1 = linceul[,"Ech. 1.age"] # On sélectionne les âges de l'échantillon 1
Err1 = linceul[,"Ech. 1.erreur"] # On sélectionne les incertitudes associées
Ech3 = linceul[,"Ech. 3.age"] # On sélectionne les âges de l'échantillon 1
Err3 = linceul[,"Ech. 3.erreur"] # On sélectionne les incertitudes associées
## Attention, pour l'interpolation linéaire, il faut ordonner les valeurs de façon croissante
courbe <- intcal20 [order(intcal20$CAL.BP), ]
# Automatically generated initial values
inits <- list(".RNG.name"="base::Wichmann-Hill", ".RNG.seed"=111)
ages_ech1 <- rjags::jags.model("calibrationIndiv.jags",
data = list('tmin' = 0, 'tmax'=5000,
'M' = Ech1,'s'=Err1, 'N' = 3, # datation par 3 labos différents
'calBP'= courbe$CAL.BP,'C14BP'= courbe$X14C.age,'sC14BP'= courbe$Sigma),
inits = inits,
n.chains = 2,
n.adapt = 50000)
## Ecriture du modele sous jags
write(file="calibrationIndiv.jags",ncolumns=1,x=
"model{
#===========================
# likelihood specification
#===========================
for( i in 1 : N ) {
# niveau du bas - lien avec variable latente mu
M[i] ~ dnorm(mu[i], tau[i])
tau[i] <- 1/(s[i]*s[i] + sigma[i]*sigma[i])
# niveau intermediaire - lien entre mu et la date calibree
mu[i] <- interp.lin( t[i], calBP, C14BP)
sigma[i] <- interp.lin( t[i], calBP, sC14BP)
}
#===========================
# prior specification
#===========================
for(i in 1:N){
t[i]~ dunif(tmin,tmax)  ## calendrier en date before present
}
}
")
Ech1 = linceul[,"Ech. 1.age"] # On sélectionne les âges de l'échantillon 1
Err1 = linceul[,"Ech. 1.erreur"] # On sélectionne les incertitudes associées
Ech3 = linceul[,"Ech. 3.age"] # On sélectionne les âges de l'échantillon 1
Err3 = linceul[,"Ech. 3.erreur"] # On sélectionne les incertitudes associées
## Attention, pour l'interpolation linéaire, il faut ordonner les valeurs de façon croissante
courbe <- intcal20 [order(intcal20$CAL.BP), ]
# Automatically generated initial values
inits <- list(".RNG.name"="base::Wichmann-Hill", ".RNG.seed"=111)
ages_ech1 <- rjags::jags.model("calibrationIndiv.jags",
data = list('tmin' = 0, 'tmax'=5000,
'M' = Ech1,'s'=Err1, 'N' = 3, # datation par 3 labos différents
'calBP'= courbe$CAL.BP,'C14BP'= courbe$X14C.age,'sC14BP'= courbe$Sigma),
inits = inits,
n.chains = 2,
n.adapt = 50000)
update(ages_ech1,50000)
samp = rjags::coda.samples(ages_ech1,c('t', 'mu'),50000,thin =10)
plot(samp)
## On affiche les âges calibrés à 95%
summary(samp, prob = 0.95)
## Intervalles HPD à 95 % des âges de l'échantillon 1
(hpd_ech1 <- hpdi(ages_ech1, credMass = 0.95))
class(ages_ech1)
?hpdi
## Intervalles HPD à 95 % des âges de l'échantillon 1
(hpd_ech1 <- hdi(ages_ech1, credMass = 0.95))
